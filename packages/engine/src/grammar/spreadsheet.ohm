SpreadsheetFormula {
  Formula = "=" Expression end
  Expression = Comparison
  Comparison = Additive (comparisonOp Additive)*
  Additive = Multiplicative (addOp Multiplicative)*
  Multiplicative = Power (multiplyOp Power)*
  Power = Unary (powerOp Unary)*
  Unary = unaryOp Unary  -- op
        | Primary
  Primary = Range               -- range
          | cellReference       -- cellReference
          | Call                -- call
          | boolean             -- boolean
          | string              -- string
          | number              -- number
          | "(" Expression ")" -- paren

  Call = identifier "(" ArgumentList? ")"
  ArgumentList = Expression ("," Expression)*
  identifier = letter alnum*
  Range = cellReference ":" cellReference  -- cells
        | columnReference ":" columnReference  -- columns

  addOp = "+" | "-"
  multiplyOp = "*" | "/"
  powerOp = "^"
  comparisonOp = "<=" | ">=" | "<>" | "=" | "<" | ">"
  unaryOp = "+" | "-"

  boolean = (caseInsensitive<"true"> | caseInsensitive<"false">) ~alnum
  string = "\"" stringCharacter* "\""
  stringCharacter = "\"\"" | ~"\"" any
  cellReference = "$"? letter+ "$"? digit+ ~alnum
  columnReference = "$"? letter+ ~alnum

  number = leadingDotNumber | wholeNumber
  leadingDotNumber = "." digit+ exponent?
  wholeNumber = digit+ ("." digit*)? exponent?
  exponent = ("e" | "E") ("+" | "-")? digit+
}
