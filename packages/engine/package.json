{
  "name": "@spreadsheet/engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate:grammar": "node scripts/generate-grammar.mjs",
    "prebuild": "pnpm generate:grammar",
    "pretest": "pnpm generate:grammar",
    "pretypecheck": "pnpm generate:grammar",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ohm-js": "^17.5.0"
  },
  "devDependencies": {
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
