{
  "name": "spreadsheet-engine-workspace",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm --filter @spreadsheet/engine build && pnpm --filter frontend build",
    "dev": "pnpm --filter frontend dev",
    "predev": "pnpm --filter @spreadsheet/engine generate:grammar",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm --filter @spreadsheet/engine test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "dependencies": {
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0"
  }
}
